---
interface Props {
  date: Date;
  /** "day" → Sep 20, 2026 · "month" → Sep 2026 · "year" → 2026 */
  precision?: 'day' | 'month' | 'year';
}

const { date, precision = 'day' } = Astro.props;

const options: Intl.DateTimeFormatOptions = {
  timeZone: 'UTC',
  year: 'numeric',
  ...(precision !== 'year' && { month: 'short' }),
  ...(precision === 'day' && { day: 'numeric' }),
};
---

<time datetime={date.toISOString().slice(0, 10)}>{date.toLocaleDateString('en-US', options)}</time>
