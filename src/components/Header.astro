---
import { NAV, SITE } from '../config';
import { normalizePath, url } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';

const current = normalizePath(Astro.url.pathname);
const home = normalizePath(url());

function isActive(path: string): boolean {
  const target = normalizePath(url(path));
  return target === home ? current === home : current.startsWith(target);
}
---

<header class="site-header">
  <div class="container inner">
    <a class="site-name" href={url()}>
      {SITE.name}
    </a>
    <nav aria-label="Main">
      <ul class="list-reset nav-list">
        {NAV.map((item) => (
          <li>
            <a href={url(item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-sans);
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'name toggle'
      'nav nav';
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding-block: var(--space-4);
  }

  .site-name {
    grid-area: name;
    font-weight: 650;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
  }

  nav {
    grid-area: nav;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    font-size: 0.92rem;
  }

  .nav-list a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .nav-list a:hover {
    color: var(--color-text);
  }

  .nav-list a[aria-current='page'] {
    color: var(--color-text);
    border-bottom-color: var(--color-accent);
  }

  .inner > :global(.theme-toggle) {
    grid-area: toggle;
  }

  @media (min-width: 52rem) {
    .inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'name nav toggle';
    }

    .nav-list {
      justify-content: flex-end;
      gap: var(--space-5);
    }
  }
</style>
