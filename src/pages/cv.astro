---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { url } from '../lib/url';

// The CV itself lives at public/cv.pdf. Replace that file to update it.
const cvUrl = url('cv.pdf');
const downloadName = `${SITE.name.replace(/\s+/g, '-')}-CV.pdf`;
---

<BaseLayout title="CV" description={`Curriculum vitae of ${SITE.name}.`}>
  <div class="container">
    <header class="page-header">
      <h1>Curriculum Vitae</h1>
      <div class="actions">
        <a class="button" href={cvUrl} download={downloadName}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19h14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
          Download PDF
        </a>
        <a class="button button--ghost" href={cvUrl}>
          Open in browser
        </a>
      </div>
    </header>

    <object class="cv-embed" data={cvUrl} type="application/pdf" aria-label={`${SITE.name} CV`}>
      <p class="muted">
        Your browser can't display the PDF inline. <a href={cvUrl}>Open the CV</a> instead.
      </p>
    </object>
  </div>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  /* Inline PDF viewers are unreliable on phones; the buttons cover that case. */
  .cv-embed {
    display: none;
  }

  .cv-embed p {
    padding: var(--space-5);
  }

  @media (min-width: 48rem) {
    .cv-embed {
      display: block;
      width: 100%;
      height: min(85vh, 70rem);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-surface);
    }
  }
</style>
